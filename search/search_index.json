{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"L&amp;T\u7684\u4e2a\u4eba\u535a\u7269\u9986"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff01\u6b22\u8fce\u6765\u5230\u6211\u7684\u4e2a\u4eba\u535a\u7269\u9986\u3002</p> <p>\u6211\u662fAurashu\uff0c\u8fd9\u91cc\u662f\u6211\u7684\u5c0f\u5c0f\u5929\u5730\uff0c\u7528\u6765\u8bb0\u5f55\uff1a</p> <ul> <li>\u5b66\u8fc7\u7684\u8bfe\u7a0b\u548c\u7b14\u8bb0</li> <li>\u5e73\u5e38\u7684\u4e2a\u4eba\u611f\u89e6\u7b49</li> <li>\u751f\u6d3b\u4e2d\u7684\u6240\u89c1\u6240\u60f3</li> <li>\u4e00\u4e9b\u6709\u8da3\u7684\u5c0f\u9879\u76ee</li> </ul> <p>\u8fd9\u4e2a\u7f51\u7ad9\u6b63\u5728\u6162\u6162\u5efa\u8bbe\u4e2d\uff0c\u656c\u8bf7\u671f\u5f85\u3002 L&amp;T\u662fLight and Truth\u7684\u82f1\u6587\u7f29\u5199\uff0c\u6fc0\u52b1\u6211\u4e0d\u65ad\u8ffd\u6c42\u5149\u548c\u771f\u7406</p>"},{"location":"about/#_2","title":"\u8054\u7cfb\u6211","text":"<ul> <li>\u90ae\u7bb1\uff1a2181752799@qq.com</li> <li>\u5176\u4ed6\u8054\u7cfb\u65b9\u5f0f\uff1a\u4fdd\u5bc6</li> </ul>"},{"location":"course/","title":"\u8bfe\u7a0b","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u6211\u5b66\u4e60\u8fc7\u7684\u8bfe\u7a0b\u4e0e\u7b14\u8bb0\uff0c\u4e0e\u5927\u5bb6\u5206\u4eab\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863 \u2014 \u5c55\u793a\u4e00\u7bc7\u6587\u7ae0\u5e94\u8be5\u600e\u4e48\u5199</li> </ul>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863","text":"<p>\u8fd9\u7bc7\u6587\u7ae0\u544a\u8bc9\u4f60\u8bfe\u7a0b\u7b14\u8bb0\u8be5\u600e\u4e48\u5199\u3002\u628a\u4e0b\u9762\u7684\u5185\u5bb9\u5f53\u4f5c\"\u6a21\u677f\"\uff0c\u7167\u7740\u683c\u5f0f\u66ff\u6362\u6210\u4f60\u81ea\u5df1\u7684\u5185\u5bb9\u5373\u53ef\u3002</p>"},{"location":"course/example/#_2","title":"\u600e\u4e48\u5199\u4e00\u7bc7\u6587\u7ae0","text":"<p>\u5199\u6587\u7ae0\u7528\u7684\u662f Markdown \u683c\u5f0f\uff0c\u5f88\u7b80\u5355\uff1a</p> <ul> <li>\u4e00\u884c <code>#</code> \u5f00\u5934\u7684\u662f\u5927\u6807\u9898\uff0c<code>##</code> \u662f\u4e8c\u7ea7\u6807\u9898\uff0c<code>###</code> \u662f\u4e09\u7ea7\u6807\u9898</li> <li>\u666e\u901a\u6587\u5b57\u76f4\u63a5\u5199\u5c31\u884c</li> <li>\u6bb5\u843d\u4e4b\u95f4\u7528\u7a7a\u4e00\u884c\u9694\u5f00</li> </ul>"},{"location":"course/example/#_3","title":"\u5e38\u7528\u683c\u5f0f\u793a\u4f8b","text":"<p>\u52a0\u7c97\u6587\u5b57\uff1a\u4e24\u4e2a\u661f\u53f7\u5305\u4f4f\u6587\u5b57\u3002</p> <p>\u659c\u4f53\u6587\u5b57\uff1a\u4e00\u4e2a\u661f\u53f7\u5305\u4f4f\u6587\u5b57\u3002</p> <p>\u5f15\u7528\u522b\u4eba\u7684\u8bdd\uff1a\u884c\u9996\u52a0\u4e00\u4e2a\u5927\u4e8e\u53f7\u3002</p> <p>\u5217\u8868\uff1a</p> <ol> <li>\u7b2c\u4e00\u6761</li> <li>\u7b2c\u4e8c\u6761</li> </ol> <p>\u4ee3\u7801\u5757\uff0c\u7528\u4e09\u4e2a\u53cd\u5f15\u53f7\u5305\u4f4f\uff1a</p> <pre><code>print(\"Hello, L&amp;T!\")\n</code></pre> <p>\u56fe\u7247\uff0c\u4e2d\u62ec\u53f7\u91cc\u5199\u8bf4\u660e\uff0c\u62ec\u53f7\u91cc\u5199\u56fe\u7247\u8def\u5f84\uff1a</p> <p></p>"},{"location":"course/example/#_4","title":"\u5c0f\u6280\u5de7","text":"<ul> <li>\u5199\u5b8c\u4fdd\u5b58\u540e\uff0c\u6d4f\u89c8\u5668\u9875\u9762\u4f1a\u81ea\u52a8\u5237\u65b0\uff0c\u4e0d\u7528\u91cd\u65b0\u542f\u52a8\u670d\u52a1</li> <li>\u6bcf\u4e2a <code>docs</code> \u4e0b\u7684 <code>.md</code> \u6587\u4ef6\u5c31\u662f\u4e00\u4e2a\u7f51\u9875</li> <li>\u5982\u679c\u60f3\u8ba9\u67d0\u4e2a <code>.md</code> \u6587\u4ef6\u51fa\u73b0\u5728\u9876\u90e8\u83dc\u5355\u91cc\uff0c\u53bb <code>mkdocs.yml</code> \u7684 <code>nav</code> \u91cc\u52a0\u4e00\u884c\u5373\u53ef</li> </ul>"},{"location":"essay/","title":"\u968f\u7b14\u9996\u9875","text":"<p>\u6b22\u8fce\u6765\u5230\u6211\u7684\u968f\u7b14\u7a7a\u95f4\uff0c\u4e00\u8d77\u89c2\u5bdf\u4e00\u8d77\u53d1\u73b0~</p>"},{"location":"essay/#_2","title":"\u5206\u7c7b\u76f4\u8fbe","text":"<ul> <li>\u884c\u8005\u65e0\u7586 \u2014\u2014 \u65c5\u9014\u4e2d\u7684\u89c1\u95fb</li> <li>\u5149\u5f71\u7559\u75d5 \u2014\u2014 \u7535\u5f71\u4e0e\u5f71\u50cf\u7684\u611f\u609f</li> <li>\u7b14\u58a8\u751f\u9999 \u2014\u2014 \u8bfb\u4e66\u7b14\u8bb0\u4e0e\u4e66\u8bc4</li> <li>\u793e\u4f1a\u767e\u6001 \u2014\u2014 \u793e\u4f1a\u73b0\u8c61\u7684\u89c2\u5bdf</li> <li>\u751f\u6d3b\u70b9\u6ef4 \u2014\u2014 \u65e5\u5e38\u751f\u6d3b\u7684\u788e\u788e\u5ff5</li> </ul>"},{"location":"essay/book/","title":"\u7b14\u58a8\u7559\u9999","text":"<p>\u8fd9\u91cc\u662f\u6211\u7684\u8bfb\u4e66\u968f\u7b14</p>"},{"location":"essay/film/","title":"\u5149\u5f71\u7559\u75d5","text":"<p>\u6211\u559c\u6b22\u770b\u5404\u6837\u7684\u5267\uff0c\u7535\u5f71\u3001\u97e9\u5267\u3001\u97f3\u4e50\u5267\u7b49\u7b49\uff0c\u4ecd\u5728\u63a2\u7d22\u4e2d\u2026\u2026</p> <p>\u53e6\u5916\uff0c\u6709\u4e9b\u63d2\u753b\u771f\u7684\u4e5f\u597d\u559c\u6b22\uff0c\u4f46\u7531\u4e8e\u8f83\u5c11\u5c31\u4e0d\u53e6\u5f00\u4e00\u7bc7\u4e86\uff0c\u4e5f\u5148\u6536\u5165\u6b64\u7ae0\uff0c\u5982\u679c\u4ee5\u540e\u5e9e\u5927\u4e86\u518d\u8003\u8651\u5355\u5f00QAQ\uff0c\u6b64\u5904\u5f3a\u70c8\u63a8\u8350\u63d2\u753b\u5e08Hellogitii~</p>"},{"location":"essay/life/","title":"\u751f\u6d3b\u70b9\u6ef4","text":"<p>\u8bb0\u5f55\u751f\u6d3b\u4e2d\u7684\u5c0f\u786e\u5e78~</p> <p>\u4eb2\u60c5\u3001\u53cb\u60c5\u3001\u7231\u60c5\u3001\u5e08\u751f\u60c5\u3001\u964c\u751f\u4eba\u4e4b\u95f4\u6e29\u6696\u771f\u8bda\u7684\u5584\u610f\u7b49\u4e00\u7cfb\u5217\u7f8e\u597d\u7684\u60c5\u611f\uff0c\u6c38\u8fdc\u90fd\u4f1a\u6253\u52a8\u6211</p>"},{"location":"essay/society/","title":"\u793e\u4f1a\u767e\u6001","text":"<p>\u89c2\u5bdf\u81ea\u5df1\u770b\u5230\u7684\uff0c\u6216\u8005\u4e00\u4e9b\u65b0\u95fb\u62a5\u9053\u7684\u79cd\u79cd\u793e\u4f1a\u73b0\u8c61\uff0c\u7528\u8fd8\u8f83\u4e3a\u7a1a\u5ae9\u7684\u773c\u5149\u548c\u7b14\u89e6\uff0c\u8fdb\u884c\u4e00\u70b9\u53ef\u80fd\u7684\u601d\u8003</p>"},{"location":"essay/travel/","title":"\u884c\u8005\u65e0\u7586","text":"<p>\u4e16\u754c\u8fd9\u4e48\u5927\uff0c\u6211\u60f3\u53bb\u770b\u770b~</p> <p>\u7528\u76ae\u80a4\u89e6\u6478\u81ea\u7136\uff0c\u547c\u5438\u611f\u53d7\u6587\u5316\uff0c\u811a\u6b65\u4e08\u91cf\u5927\u5730\uff0c\u671f\u5f85\u53bb\u5f80\u66f4\u591a\u66f4\u8fdc\u7684\u5730\u65b9\uff0c\u770b\u5230\u66f4\u5e7f\u9614\u66f4\u771f\u5b9e\u5730\u4e16\u754c</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u8fd9\u91cc\u653e\u4e00\u4e9b\u670b\u53cb\u4eec\u7684\u7f51\u7ad9\u94fe\u63a5\uff0c\u4e92\u76f8\u4e32\u95e8\u3002</p>"},{"location":"friends/#_2","title":"\u670b\u53cb\u4eec\u7684\u7f51\u7ad9","text":"<ul> <li>\u670b\u53cb A \u7684\u535a\u5ba2 \u2014 \u4e00\u4e2a\u793a\u4f8b\u94fe\u63a5</li> <li>\u670b\u53cb B \u7684\u7f51\u7ad9 \u2014 \u53e6\u4e00\u4e2a\u793a\u4f8b\u94fe\u63a5</li> </ul> <p>\u5c0f\u63d0\u793a\uff1a\u4ee5\u540e\u628a\u94fe\u63a5\u6587\u5b57\u6539\u6210\u670b\u53cb\u7684\u540d\u5b57\uff0c\u628a\u94fe\u63a5\u5730\u5740\u6362\u6210\u4ed6\u4eec\u771f\u5b9e\u7684\u7f51\u5740\u5373\u53ef\u3002</p>"}]}